# =====================================================================
# SAH-RAG Environment Variables (template)
# Copy to .env and fill in real values.
# =====================================================================

# ---------------------------------------------------------------------
# Canonical datasets (required)
# ---------------------------------------------------------------------
# Root of the canonical datasets (documents.jsonl + examples.jsonl)
RAG_CANONICAL_ROOT=C:/Users/USER1/Documents/SAH-RAG/data/processed/canonical

# ---------------------------------------------------------------------
# LLM paths (required for controlled mode)
# ---------------------------------------------------------------------
# Indoor LLM (14B) - used for entity/relation extraction in controlled baselines.
# Mandated by LLM fairness policy (docs/llm_fairness_policy.md).
RAG_INDOOR_LLM_ROOT=D:/rag_work/models/Qwen2.5-14B-Instruct

# Generation LLM (32B) - used for answer generation.
# Fallback policy: if 32B unavailable, falls back to 14B (RAG_INDOOR_LLM_ROOT).
RAG_GENERATION_LLM_ROOT=D:/rag_work/models/Qwen2.5-32B-Instruct

# ---------------------------------------------------------------------
# Embedder path (optional)
# ---------------------------------------------------------------------
# BGE-M3 weights for controlled-mode injection.
# If not set, defaults to D:/rag_work/hf_cache/models--BAAI--bge-m3/snapshots/<rev>.
# RAG_EMBEDDER_ROOT=D:/rag_work/hf_cache/models--BAAI--bge-m3

# ---------------------------------------------------------------------
# External APIs (required only for specific native baselines)
# ---------------------------------------------------------------------
# These are required for NATIVE E2E mode of specific baselines:
#   - OPENAI_API_KEY: hipporag2 native, lightrag native, multi_meta_rag native
#   - GOOGLE_API_KEY: lightrag native (alternative to OpenAI)
#   - AZURE_OPENAI_*: alternative for OpenAIBasedReader (LongRAG)
#
# Controlled mode is LLM-free and does NOT require these.
#
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# AZURE_OPENAI_KEY=...
# AZURE_OPENAI_ENDPOINT=https://...
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ---------------------------------------------------------------------
# External repos (optional)
# ---------------------------------------------------------------------
# PathRAG official repo (deferred until license resolved)
# PATH_RAG_REPO=D:/rag_work/external/pathrag_official

# ---------------------------------------------------------------------
# Legacy v1 paths (kept for backwards compatibility)
# ---------------------------------------------------------------------
SAH_RAG_MODELS_DIR=D:/rag_work/models
SAH_RAG_EXPERIMENTS_DIR=D:/rag_work/experiments
SAH_RAG_DATA_RAW_DIR=D:/rag_work/data/raw
SAH_RAG_HF_CACHE=D:/rag_work/hf_cache
SAH_RAG_TORCH_CACHE=D:/rag_work/torch_cache
SAH_RAG_EXTERNAL_DIR=D:/rag_work/external