          "title": "Available Citation Ids",
          "type": "array"
        },
        "citation_occurrence_count": {
          "minimum": 0,
          "title": "Citation Occurrence Count",
          "type": "integer"
        },
        "has_citations": {
          "title": "Has Citations",
          "type": "boolean"
        },
        "unknown_citation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unknown Citation Ids",
          "type": "array"
        },
        "unused_citation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Unused Citation Ids",
          "type": "array"
        },
        "used_citation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Used Citation Ids",
          "type": "array"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "available_citation_ids",
        "used_citation_ids",
        "unknown_citation_ids",
        "unused_citation_ids",
        "citation_occurrence_count",
        "has_citations",
        "all_citations_known",
        "valid"
      ],
      "title": "AnswerCitationValidation",
      "type": "object"
    }
  },
  "additionalProperties": false,
