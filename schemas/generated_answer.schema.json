    "context_pack_id": {
      "title": "Context Pack Id",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "finish_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finish Reason"
    },
    "generation_model_id": {
      "title": "Generation Model Id",
      "type": "string"
    },
    "generation_model_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Model Revision"
    },
    "generation_parameters": {
      "additionalProperties": true,
      "title": "Generation Parameters",
      "type": "object"
    },
    "generation_runtime": {
      "title": "Generation Runtime",
      "type": "string"
    },
    "input_token_count": {
      "minimum": 0,
      "title": "Input Token Count",
      "type": "integer"
    },
    "insufficient_context": {
      "default": false,
      "title": "Insufficient Context",
      "type": "boolean"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "output_token_count": {
      "minimum": 0,
      "title": "Output Token Count",
      "type": "integer"
    },
    "prompt_id": {
      "title": "Prompt Id",
      "type": "string"
    },
    "query_id": {
      "title": "Query Id",
      "type": "string"
    },
    "refused": {
      "default": false,
      "title": "Refused",
      "type": "boolean"
