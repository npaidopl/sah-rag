      "title": "Answer Id",
      "type": "string"
    },
    "answer_text": {
      "title": "Answer Text",
      "type": "string"
    },
    "artifact_type": {
      "default": "generated_answer",
      "title": "Artifact Type",
      "type": "string"
    },
    "artifact_version": {
      "default": "1.0",
      "title": "Artifact Version",
      "type": "string"
    },
    "citation_validation": {
      "$ref": "#/$defs/AnswerCitationValidation"
